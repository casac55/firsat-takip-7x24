# Telegram Bot Ayarları
# 1. Telegram'da @BotFather'a /newbot yazarak token alın
TELEGRAM_BOT_TOKEN=buraya_bot_token_yazin

# 2. @userinfobot veya botunuza mesaj atıp getUpdates üzerinden Chat ID'nizi alın
TELEGRAM_CHAT_ID=buraya_chat_id_yazin

# 3. (Opsiyonel) Gerçek Telegram Sesli Arama ile Uyandırma için CallMeBot kullanıcı adınız:
# Kullanmak için Telegram'da @CallMeBot_txtbot'a /start yazıp onay verin ve @kullanici_adi girin
CALLMEBOT_TELEGRAM_USER=

# 4. (Opsiyonel) X (Twitter) Otomatik Fırsat Paylaşımı (developer.x.com -> Read and Write)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
